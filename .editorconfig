root = true

[*.cs]
# Write the actual type instead of `var`, so code reads clearly when browsing.
# (`var` is still needed where a type has no name, e.g. anonymous types.)
csharp_style_var_for_built_in_types = false:warning
csharp_style_var_when_type_is_apparent = false:warning
csharp_style_var_elsewhere = false:warning
dotnet_diagnostic.IDE0008.severity = warning

# Block bodies, not `=>`, for every kind of member (see CLAUDE.md → Code style → Members).
# Old code still has many `=>` members; they are converted gradually, so expect these warnings in older files.
csharp_style_expression_bodied_methods = false:warning
csharp_style_expression_bodied_properties = false:warning
csharp_style_expression_bodied_accessors = false:warning
csharp_style_expression_bodied_constructors = false:warning
csharp_style_expression_bodied_indexers = false:warning
csharp_style_expression_bodied_operators = false:warning
csharp_style_expression_bodied_local_functions = false:warning
dotnet_diagnostic.IDE0021.severity = warning
dotnet_diagnostic.IDE0022.severity = warning
dotnet_diagnostic.IDE0023.severity = warning
dotnet_diagnostic.IDE0024.severity = warning
dotnet_diagnostic.IDE0025.severity = warning
dotnet_diagnostic.IDE0026.severity = warning
dotnet_diagnostic.IDE0027.severity = warning
dotnet_diagnostic.IDE0061.severity = warning

# Write `new List<Node>()`, not `new()`.
csharp_style_implicit_object_creation_when_type_is_apparent = false:warning
dotnet_diagnostic.IDE0090.severity = warning

# Don't suggest switch expressions or property patterns; switch statements and `is Type t` are the house style.
csharp_style_prefer_switch_expression = false:silent
csharp_style_prefer_pattern_matching = false:silent
csharp_style_prefer_extended_property_pattern = false:silent
