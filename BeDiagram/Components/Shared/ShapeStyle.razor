<label>Colour</label>
<div class="swatch-picker">
    <button class="swatch default @On(n => n.Color is null)" title="Type default" @onclick="() => Set(n => n.Color = null)">∅</button>
    <div class="swatch-grid">
        @foreach (string k in Palette.Keys)
        {
            <button class="swatch @On(n => n.Color == k)" style="background:@(AllFilled ? Palette.Get(k).Solid : Palette.Get(k).Light);border-color:@Palette.Get(k).Stroke" title="@k"
                    @onclick="() => Set(n => n.Color = k)"></button>
        }
    </div>
</div>
<label class="check" title="@FillTitle"><input type="checkbox" checked="@FillChecked" disabled="@FillForced" @onchange="e => Set(n => n.Filled = e.Value is true)" /> Solid fill (presentation style)</label>
<label>Emphasis</label>
<div class="seg wide">
    @foreach (IEmphasis em in Emphases.All)
    {
        <button class="@On(n => Emphases.Of(n) == em)" title="@em.Hint" @onclick="() => SetEmphasis(em.Level)">@em.Name</button>
    }
</div>
<PresetPicker Presets="SavedStyles" Capture="Capture" TextChoices="PresetTexts.ForShape" OnApply="ApplyPreset" OnChanged="OnChanged" />
