<h4>Text</h4>
<div class="seg wide three">
    @foreach ((string k, string name) in TextLook.Fonts)
    {
        <button class="@On(t => t.Font == k)" style="font-family:@TextLook.Family(k)" @onclick="() => Editor.Restyle(Boxes, t => t.Font = k)">@name</button>
    }
</div>
<div class="row">
    <div>
        <label>Size</label>
        <select value="@SizeValue" @onchange="e => Editor.SetFontSize(Boxes, e.Value)">
            @if (SizeValue == "")
            {
                <option value="">—</option>
            }
            @foreach (double sz in SizeChoices)
            {
                <option value="@F(sz)">@F(sz)</option>
            }
        </select>
    </div>
    <div>
        <label>&nbsp;</label>
        <label class="check"><input type="checkbox" checked="@AllBold" @onchange="e => Editor.Restyle(Boxes, t => t.Bold = e.Value is true)" /> Bold</label>
    </div>
</div>
<label>Alignment</label>
<div class="seg wide three">
    @foreach ((string k, string name) in HAligns)
    {
        <button class="@On(t => t.Align == k)" @onclick="() => Editor.Restyle(Boxes, t => t.Align = k)">@name</button>
    }
</div>
<div class="seg wide three" style="margin-top:6px">
    @foreach ((string k, string name) in VAligns)
    {
        <button class="@On(t => t.VAlign == k)" @onclick="() => Editor.Restyle(Boxes, t => t.VAlign = k)">@name</button>
    }
</div>
<label>Text colour</label>
<div class="swatches">
    <button class="swatch line @On(t => t.TextColor is null)" title="Default" @onclick="() => Editor.Restyle(Boxes, t => t.TextColor = null)"><span style="background:@TextStyle.DefaultText"></span></button>
    @foreach (string k in TextPalette.Strokes)
    {
        <button class="swatch line @On(t => t.TextColor == k)" title="@k" @onclick="() => Editor.Restyle(Boxes, t => t.TextColor = k)"><span style="background:@TextPalette.StrokeOf(k, TextStyle.DefaultText)"></span></button>
    }
</div>

<h4>Box</h4>
<label>Background</label>
<div class="swatches">
    <button class="swatch default @On(t => t.Fill is null)" title="None (transparent)" @onclick="() => Editor.Restyle(Boxes, t => t.Fill = null)">∅</button>
    @foreach (string k in TextPalette.Fills)
    {
        <button class="swatch @On(t => t.Fill == k)" style="background:@TextPalette.All[k].Fill;border-color:@TextPalette.All[k].Stroke" title="@k" @onclick="() => Editor.Restyle(Boxes, t => t.Fill = k)"></button>
    }
</div>
<label>Border</label>
<div class="seg wide patterns">
    <button class="@On(t => t.Border == TextLook.NoBorder)" title="No border" @onclick="() => Editor.Restyle(Boxes, t => t.Border = TextLook.NoBorder)">None</button>
    @foreach ((string k, string name) in LineLook.Patterns)
    {
        <button class="@On(t => t.Border == k)" title="@name" @onclick="() => Editor.Restyle(Boxes, t => t.Border = k)">@LinePreview(SampleWeight, k, LineLook.ArrowNone)</button>
    }
</div>
@if (AnyBorder)
{
    <label>Border weight</label>
    <div class="seg wide stacked">
        @foreach ((string k, string name) in LineLook.Weights)
        {
            <button class="@On(t => t.BorderWeight == k)" title="@name" @onclick="() => Editor.Restyle(Boxes, t => t.BorderWeight = k)">@LinePreview(k, LineLook.Solid, LineLook.ArrowNone) @name</button>
        }
    </div>
    <label>Border colour</label>
    <div class="swatches">
        <button class="swatch line @On(t => t.BorderColor is null)" title="Default grey" @onclick="() => Editor.Restyle(Boxes, t => t.BorderColor = null)"><span style="background:@TextStyle.DefaultBorder"></span></button>
        @foreach (string k in TextPalette.Strokes)
        {
            <button class="swatch line @On(t => t.BorderColor == k)" title="@k" @onclick="() => Editor.Restyle(Boxes, t => t.BorderColor = k)"><span style="background:@TextPalette.StrokeOf(k, TextStyle.DefaultBorder)"></span></button>
        }
    </div>
}
<label class="check"><input type="checkbox" checked="@AllRounded" @onchange="e => Editor.Restyle(Boxes, t => t.Rounded = e.Value is true)" /> Rounded corners</label>
