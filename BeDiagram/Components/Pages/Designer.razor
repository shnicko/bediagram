@page "/"
@implements IAsyncDisposable

<PageTitle>@(D.Name)@(Editor.Dirty ? " •" : "") — BeDiagram</PageTitle>

<div class="app">
    @* ───────────── Toolbar ───────────── *@
    <header class="toolbar">
        <div class="brand">◆ BeDiagram</div>
        <nav class="menubar">
            <DropMenu Title="File" OpenMenu="@openMenu" OpenMenuChanged="SetOpenMenu">
                <button @onclick="NewDiagram" title="New diagram">New</button>
                <button @onclick="ShowOpen" title="Open a saved diagram">Open…</button>
                <button @onclick="() => Run(Cmd.Save)" title="@Tip(Cmd.Save)">Save<span class="menu-key">@KeyText(Cmd.Save)</span></button>
                <button @onclick="() => Run(Cmd.SaveAs)" title="@Tip(Cmd.SaveAs)">Save as…<span class="menu-key">@KeyText(Cmd.SaveAs)</span></button>
                <hr class="menu-divider" />
                <div class="menu-heading">Export <span class="muted-label">next to the saved diagram</span></div>
                @foreach (ExportMenuItem item in ExportMenuItems())
                {
                    if (item.StartsGroup)
                    {
                        <hr class="menu-divider" />
                    }
                    <button @onclick="() => Export(item.Choice)" title="@item.Tip">@item.Label</button>
                }
                <div class="menu-settings" @onclick:stopPropagation="true">
                    <span class="muted-label">PNG settings</span>
                    <label title="Size of the PNG in pixels">
                        Resolution
                        <select value="@exportOptions.PngResolution" @onchange="SetPngResolution">
                            @for (int i = 0; i < PngResolutions.Count; i++)
                            {
                                <option value="@i">@PngResolutions[i].Label</option>
                            }
                        </select>
                    </label>
                    <label title="No white background — for placing over slides or coloured pages">
                        <input type="checkbox" checked="@exportOptions.PngTransparent" @onchange="SetPngTransparent" />
                        Transparent background
                    </label>
                </div>
                <hr class="menu-divider" />
                <div class="menu-settings" @onclick:stopPropagation="true" title="Where the next step goes when you add one from the sidebar, a number key or + Next step">
                    <span class="muted-label">Flow direction</span>
                    <div class="seg">
                        <button class="@FlowClass(FlowDirection.Right)" title="New steps go to the right" @onclick="() => Editor.SetFlow(FlowDirection.Right)">@IconSvg("arrow-right", 16) Left → right</button>
                        <button class="@FlowClass(FlowDirection.Down)" title="New steps go below" @onclick="() => Editor.SetFlow(FlowDirection.Down)">@IconSvg("arrow-down", 16) Top → down</button>
                    </div>
                </div>
                <hr class="menu-divider" />
                <div class="menu-settings" @onclick:stopPropagation="true" title="Canvas size: open canvas or a fixed paper size">
                    <span class="muted-label">Page</span>
                    <select class="page-select" value="@D.Page.Size" @onchange="SetPageSize">
                        <option value="@PageSetup.None">Open canvas</option>
                        @foreach ((string Key, string Name, double W, double H) ps in PageSetup.Sizes)
                        {
                            <option value="@ps.Key">@ps.Name</option>
                        }
                        <option value="@PageSetup.Custom">Custom…</option>
                    </select>
                    @if (D.Page.Enabled)
                    {
                        <div class="seg">
                            <button class="@(!PageIsLandscape ? "on" : "")" title="Portrait" @onclick="SetPortrait">@IconSvg("rectangle-vertical", 16) Portrait</button>
                            <button class="@(PageIsLandscape ? "on" : "")" title="Landscape" @onclick="SetLandscape">@IconSvg("rectangle-horizontal", 16) Landscape</button>
                        </div>
                    }
                </div>
            </DropMenu>
            <DropMenu Title="Edit" OpenMenu="@openMenu" OpenMenuChanged="SetOpenMenu">
                <button disabled="@(!CanRun(Cmd.Undo))" @onclick="() => Run(Cmd.Undo)">Undo<span class="menu-key">@KeyText(Cmd.Undo)</span></button>
                <button disabled="@(!CanRun(Cmd.Redo))" @onclick="() => Run(Cmd.Redo)">Redo<span class="menu-key">@KeyText(Cmd.Redo)</span></button>
                <hr class="menu-divider" />
                <button @onclick="() => Run(Cmd.SelectAll)">Select all<span class="menu-key">@KeyText(Cmd.SelectAll)</span></button>
                <button disabled="@(!CanRun(Cmd.Duplicate))" @onclick="() => Run(Cmd.Duplicate)">Duplicate<span class="menu-key">@KeyText(Cmd.Duplicate)</span></button>
                <button disabled="@(!CanRun(Cmd.Delete))" @onclick="() => Run(Cmd.Delete)">Delete<span class="menu-key">@KeyText(Cmd.Delete)</span></button>
                <hr class="menu-divider" />
                <button disabled="@(!CanRun(Cmd.Join))" @onclick="() => Run(Cmd.Join)">Join in selection order<span class="menu-key">@KeyText(Cmd.Join)</span></button>
                <button disabled="@(!CanRun(Cmd.Branch))" @onclick="() => Run(Cmd.Branch)">Branch pass / fail<span class="menu-key">@KeyText(Cmd.Branch)</span></button>
                <button disabled="@(!CanRun(Cmd.Group))" @onclick="() => Run(Cmd.Group)">Group<span class="menu-key">@KeyText(Cmd.Group)</span></button>
                <button disabled="@(!CanRun(Cmd.Ungroup))" @onclick="() => Run(Cmd.Ungroup)">Ungroup<span class="menu-key">@KeyText(Cmd.Ungroup)</span></button>
                <hr class="menu-divider" />
                <div class="menu-settings" @onclick:stopPropagation="true">
                    <label title="New items join to the selected item automatically"><input type="checkbox" @bind="Editor.AutoConnect" /> Auto-join new items</label>
                    <label title="Snap to a 10px grid"><input type="checkbox" @bind="Editor.Snap" /> Snap to grid</label>
                    <span class="muted-label">Angle lock</span>
                    <div class="seg" title="Angle lock when moving items and placing joined steps">
                        @foreach (IAngleLock a in AngleLocks.All)
                        {
                            <button class="@(Editor.AngleLock == a ? "on" : "")" title="@a.Name" @onclick="() => SetAngleLock(a)">@a.Label</button>
                        }
                    </div>
                </div>
            </DropMenu>
            <DropMenu Title="Arrange" OpenMenu="@openMenu" OpenMenuChanged="SetOpenMenu">
                <button title="Put the steps in order: drag to reorder, or set steps to run in parallel" @onclick="ShowStepOrder">Step order…</button>
                <button title="@Cmd.TidyTip" disabled="@(!CanRun(Cmd.Tidy))" @onclick="() => Run(Cmd.Tidy)">Tidy connectors</button>
                <hr class="menu-divider" />
                <div class="menu-heading">Auto-layout</div>
                <button title="@Cmd.LayoutTip(Cmd.LayoutAcross)" disabled="@(!CanRun(Cmd.LayoutAcross))" @onclick="() => Run(Cmd.LayoutAcross)">@IconSvg("arrow-right", 16) Left → right</button>
                <button title="@Cmd.LayoutTip(Cmd.LayoutDown)" disabled="@(!CanRun(Cmd.LayoutDown))" @onclick="() => Run(Cmd.LayoutDown)">@IconSvg("workflow", 16) Top → down</button>
                <div class="menu-heading">Swim lanes</div>
                <button title="@Cmd.LanesTip(Cmd.LanesAcross)" disabled="@(!CanRun(Cmd.LanesAcross))" @onclick="() => Run(Cmd.LanesAcross)">@IconSvg("rows-3", 16) Left → right</button>
                <button title="@Cmd.LanesTip(Cmd.LanesDown)" disabled="@(!CanRun(Cmd.LanesDown))" @onclick="() => Run(Cmd.LanesDown)">@IconSvg("columns-3", 16) Top → down</button>
                <div class="menu-settings" @onclick:stopPropagation="true">
                    <label title="Adding or moving shapes won't resize the lanes. Arrange, resizing a lane by hand and Fit to contents still do."><input type="checkbox" checked="@D.LockLanes" @onchange="SetLockLanes" /> Lock lane size</label>
                </div>
                <hr class="menu-divider" />
                <div class="menu-settings" @onclick:stopPropagation="true" title="Line style for new connectors">
                    <span class="muted-label">New connectors</span>
                    <div class="seg">
                        <button class="@(D.DefaultConnector == EdgeStyle.Elbow ? "on" : "")" title="Right-angled connectors" @onclick="() => Editor.SetDefaultConnector(EdgeStyle.Elbow)">@IconSvg("corner-down-right", 16) Elbow</button>
                        <button class="@(D.DefaultConnector == EdgeStyle.Straight ? "on" : "")" title="Straight connectors" @onclick="() => Editor.SetDefaultConnector(EdgeStyle.Straight)">@IconSvg("move-up-right", 16) Straight</button>
                    </div>
                </div>
            </DropMenu>
            <DropMenu Title="View" OpenMenu="@openMenu" OpenMenuChanged="SetOpenMenu">
                <div class="menu-settings" @onclick:stopPropagation="true">
                    <label title="Show each shape's step number (the order is kept either way)"><input type="checkbox" checked="@D.ShowSteps" @onchange="e => Editor.SetShowSteps(e.Value is true)" /> Show step numbers</label>
                </div>
                <hr class="menu-divider" />
                <button @onclick="() => Run(Cmd.ZoomIn)">Zoom in<span class="menu-key">@KeyText(Cmd.ZoomIn)</span></button>
                <button @onclick="() => Run(Cmd.ZoomOut)">Zoom out<span class="menu-key">@KeyText(Cmd.ZoomOut)</span></button>
                <button @onclick="() => Run(Cmd.ResetZoom)">Zoom to 100%<span class="menu-key">@KeyText(Cmd.ResetZoom)</span></button>
                <button @onclick="() => Run(Cmd.Fit)">Fit to window<span class="menu-key">@KeyText(Cmd.Fit)</span></button>
                <button disabled="@(!CanRun(Cmd.FitSelection))" @onclick="() => Run(Cmd.FitSelection)">Zoom to selection<span class="menu-key">@KeyText(Cmd.FitSelection)</span></button>
            </DropMenu>
            <DropMenu Title="Help" OpenMenu="@openMenu" OpenMenuChanged="SetOpenMenu">
                <button @onclick="ShowShortcuts">Keyboard shortcuts…</button>
            </DropMenu>
        </nav>
        @if (trail.Count > 0)
        {
            <div class="group trail" title="You opened this diagram from a link — click a name to go back up">
                <button class="back" @onclick="GoBack" title="Back to @trail[^1]">← Back</button>
                @foreach (Crumb c in Crumbs)
                {
                    <button class="link crumb" @onclick="() => GoUpTo(c.Level)">@c.Name</button><span class="crumb-sep">›</span>
                }
                <span class="crumb-here">@D.Name</span>
            </div>
        }
        <div class="group">
            <button @onclick="() => Run(Cmd.Undo)" disabled="@(!CanRun(Cmd.Undo))" title="@Tip(Cmd.Undo)">↶</button>
            <button @onclick="() => Run(Cmd.Redo)" disabled="@(!CanRun(Cmd.Redo))" title="@Tip(Cmd.Redo)">↷</button>
        </div>
        <div class="group" title="Background grid (screen only, not exported)">
            <span class="muted-label">Grid</span>
            <div class="seg">
                @foreach ((string k, string name, string icon) in GridLook.Options)
                {
                    <button class="@(grid == k ? "on" : "")" title="@name" @onclick="() => SetGrid(k)">@IconSvg(icon, 16)</button>
                }
            </div>
        </div>
        <div class="group">
            <button @onclick="() => Run(Cmd.ZoomOut)" title="@Tip(Cmd.ZoomOut)">−</button>
            <span class="zoom">@((int)Math.Round(Zoom * 100))%</span>
            <button @onclick="() => Run(Cmd.ZoomIn)" title="@Tip(Cmd.ZoomIn)">+</button>
            <button @onclick="() => Run(Cmd.Fit)" title="@Tip(Cmd.Fit)">Fit</button>
            <button @onclick="() => Run(Cmd.FitSelection)" disabled="@(!CanRun(Cmd.FitSelection))" title="@Tip(Cmd.FitSelection)">Selection</button>
        </div>
        <div class="group">
            <div class="seg" title="Flow direction: where the next step goes when you add one from the sidebar, a number key or + Next step">
                <button class="@FlowClass(FlowDirection.Right)" title="Flow left → right: new steps go to the right" @onclick="() => Editor.SetFlow(FlowDirection.Right)">@IconSvg("arrow-right", 16)</button>
                <button class="@FlowClass(FlowDirection.Down)" title="Flow top → down: new steps go below" @onclick="() => Editor.SetFlow(FlowDirection.Down)">@IconSvg("arrow-down", 16)</button>
            </div>
            <button class="@SnapClass" title="@SnapTip" @onclick="ToggleSnap">@IconSvg("magnet", 16)</button>
        </div>
        <div class="title">
            <span>@D.Name</span>@if (Editor.Dirty) {<span class="dirty" title="Unsaved changes">●</span>}
        </div>
    </header>
    @if (openMenu is not null)
    {
        <div class="menu-backdrop" @onclick="CloseMenus"></div>
    }

    @* ───────────── Palette ───────────── *@
    <aside class="palette">
        <div class="section">Shapes</div>
        <div class="tiles three">
            @foreach (PaletteShape p in PaletteShapes)
            {
                <div class="tile" draggable="true" data-palette="@p.Type.Name" data-tip="@PaletteShapeTip(p)" aria-label="@p.Type.Display"
                     @ondragstart="() => StartPaletteDrag(p.Type.Key)"
                     @onclick="() => Editor.QuickAdd(p.Type.Key)">
                    <svg width="48" height="30" viewBox="-2 -2 52 32">
                        <path d="@PaletteShapePath(p.Type.Key)" fill="@p.Type.Fill" stroke="@p.Type.Stroke" stroke-width="1.5" />
                        @if (PaletteInnerPath(p.Type.Key) is { } inner)
                        {
                            <path d="@inner" fill="none" stroke="@p.Type.Stroke" stroke-width="1" />
                        }
                    </svg>
                    @if (p.HasKey)
                    {
                        <kbd>@p.Number</kbd>
                    }
                </div>
            }
        </div>
        <div class="section">Circles</div>
        <div class="tiles four">
            @foreach (NodeTypeInfo t in RoundShapes)
            {
                <div class="tile" draggable="true" data-palette="@RoundItem(t).Key" data-tip="@RoundPaletteTip(t)" aria-label="@(t.Display) circle"
                     @ondragstart="() => StartPaletteDrag(RoundItem(t))"
                     @onclick="() => Editor.QuickAdd(RoundItem(t))">
                    @RoundSwatch(t.Key, 26)
                </div>
            }
        </div>
        <div class="section">Outcomes</div>
        <div class="tiles five">
            @foreach (OutcomeInfo o in Outcomes.All)
            {
                <div class="tile" draggable="true" data-palette="@OutcomeItem(o).Key" data-tip="@OutcomePaletteTip(o)" aria-label="@o.Display"
                     @ondragstart="() => StartPaletteDrag(OutcomeItem(o))"
                     @onclick="() => Editor.QuickAdd(OutcomeItem(o))">
                    @OutcomeSwatch(o.Key, 24)
                </div>
            }
        </div>
        <div class="section">Text &amp; groups</div>
        <div class="tiles three">
            <div class="tile" draggable="true" data-palette="text" data-tip="Text box: drag onto the canvas, click to add, or press T" aria-label="Text box"
                 @ondragstart="StartTextDrag"
                 @onclick="Editor.AddTextQuick">
                <svg width="48" height="30" viewBox="-2 -2 52 32">
                    <rect x="4" y="2" width="40" height="24" rx="3" fill="#ffffff" stroke="#9aa3ad" stroke-width="1.2" stroke-dasharray="3 2" />
                    <path d="M12,9 H36 M24,9 V21" stroke="#55606e" stroke-width="2" stroke-linecap="round" />
                </svg>
                <kbd>T</kbd>
            </div>
            <div class="tile" draggable="true" data-palette="comment" data-tip="Comment: drag onto the canvas, click to add, or press C" aria-label="Comment"
                 @ondragstart="StartCommentDrag"
                 @onclick="Editor.AddCommentQuick">
                <svg width="48" height="30" viewBox="-2 -2 52 32">
                    <rect x="4" y="0" width="40" height="28" rx="3" fill="#fff7c2" stroke="#d9c255" stroke-width="1.5" />
                    <path d="M10,9 H38 M10,15 H34 M10,21 H26" stroke="#b9a64a" stroke-width="1.5" />
                </svg>
                <kbd>C</kbd>
            </div>
            <div class="tile" draggable="true" data-palette="group" data-tip="Group: drag onto the canvas, or select items and press Ctrl+G" aria-label="Group"
                 @ondragstart="StartGroupDrag"
                 @onclick="Editor.AddGroupQuick">
                <svg width="48" height="30" viewBox="-2 -2 52 32">
                    <rect x="1" y="1" width="46" height="26" rx="4" fill="#eef3fb" stroke="#3b6fb6" stroke-width="1.5" />
                    <path d="M1,9 H47" stroke="#3b6fb6" stroke-width="1.2" />
                    <rect x="8" y="14" width="12" height="8" rx="2" fill="#fff" stroke="#3b6fb6" />
                    <rect x="28" y="14" width="12" height="8" rx="2" fill="#fff" stroke="#3b6fb6" />
                </svg>
                <kbd>G</kbd>
            </div>
        </div>
        <div class="section">Quick add <InfoTip>Hover a tile to see what it is. Select an item, then press a number to add the next step below it (joined to it when Auto-join is on).</InfoTip></div>
    </aside>

    @* ───────────── Canvas ───────────── *@
    <main class="canvas" @ref="canvasEl"
          @ondragover:preventDefault="true" @ondragover="DragOver"
          @ondrop="OnDrop">
        <svg class="@SurfaceClass"
             @onpointerdown="BgDown" @onpointermove="PointerMove"
             @onpointerup="PointerUp" @onpointerleave="PointerUp"
             @ondblclick="BgDoubleClick">
            <defs>
                <pattern id="grid" width="20" height="20" patternUnits="userSpaceOnUse" patternTransform="@GridTransform">
                    <circle cx="1" cy="1" r="1" fill="#cfd5dc" />
                </pattern>
                <pattern id="grid-world" width="20" height="20" patternUnits="userSpaceOnUse">
                    <circle cx="1" cy="1" r="1" fill="#d5dae0" />
                </pattern>
                <pattern id="grid-lines" width="20" height="20" patternUnits="userSpaceOnUse" patternTransform="@GridTransform">
                    <path d="M20 0.5 H0.5 V20" fill="none" stroke="#dde2e8" stroke-width="1" />
                </pattern>
                <pattern id="grid-world-lines" width="20" height="20" patternUnits="userSpaceOnUse">
                    <path d="M20 0.5 H0.5 V20" fill="none" stroke="#e4e8ed" stroke-width="1" />
                </pattern>
                <filter id="page-shadow" x="-5%" y="-5%" width="110%" height="110%">
                    <feDropShadow dx="0" dy="2" stdDeviation="6" flood-color="#1f2933" flood-opacity="0.16" />
                </filter>
                <marker id="arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="8" markerHeight="8" orient="auto-start-reverse">
                    <path d="M0,0 L10,5 L0,10 z" fill="#55606e" />
                </marker>
                <marker id="arrow-sel" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="8" markerHeight="8" orient="auto-start-reverse">
                    <path d="M0,0 L10,5 L0,10 z" fill="#2563eb" />
                </marker>
                @ArrowMarkerDefs
            </defs>
            <rect class="grid" width="100%" height="100%" fill="@CanvasFill" />

            <g transform="@GridTransform">
                @* Page sheet (fixed paper size) *@
                @if (D.Page.Enabled)
                {
                    <g class="page">
                        <rect x="0" y="0" width="@F(D.Page.WidthPx)" height="@F(D.Page.HeightPx)" fill="#ffffff" filter="url(#page-shadow)" />
                        @if (PageGridFill is { } pageFill)
                        {
                            <rect x="0" y="0" width="@F(D.Page.WidthPx)" height="@F(D.Page.HeightPx)" fill="@pageFill" />
                        }
                        @if (D.Page.MarginPx > 0)
                        {
                            <rect class="page-margin" x="@F(D.Page.MarginPx)" y="@F(D.Page.MarginPx)" width="@F(PrintableW)" height="@F(PrintableH)" />
                        }
                        <g><text class="page-caption" x="0" y="-8" style="@PageCaptionStyle">@D.Page.Describe()</text></g>
                    </g>
                }

                @* Groups are the bottom layer *@
                @foreach (GroupView v in GroupViews())
                {
                    <g class="group @(v.Selected ? "selected" : "")">
                        @if (v.Selected)
                        {
                            <rect class="sel-outline" x="@F(GroupSelectionRect(v.G).X)" y="@F(GroupSelectionRect(v.G).Y)"
                                  width="@F(GroupSelectionRect(v.G).W)" height="@F(GroupSelectionRect(v.G).H)" rx="13" />
                        }
                        <rect class="group-body" x="@F(v.G.X)" y="@F(v.G.Y)" width="@F(v.G.W)" height="@F(v.G.H)" rx="10"
                              fill="@v.Swatch.Light" fill-opacity="@F(v.FillOpacity)" stroke="@v.Swatch.Stroke" stroke-width="@F(v.Width)"
                              stroke-dasharray="@v.Dash"
                              @onpointerdown="e => GroupBodyDown(e, v.G.Id)" @onpointerdown:stopPropagation="true" />
                        @if (v.BandPath is { } band)
                        {
                            <path d="@band" fill="@v.Swatch.Stroke" fill-opacity="0.14" pointer-events="none" />
                        }
                        @* Title area: the drag handle (double-click to rename) *@
                        <rect class="group-header" x="@F(v.TitleArea.X)" y="@F(v.TitleArea.Y)" width="@F(v.TitleArea.W)" height="@F(v.TitleArea.H)" fill="transparent"
                              @onpointerdown="e => ItemDown(e, v.G.Id)" @onpointerdown:stopPropagation="true"
                              @ondblclick="() => Editor.BeginEdit(v.G.Id)" @ondblclick:stopPropagation="true" />
                        @if (Editor.EditingId == v.G.Id)
                        {
                            <foreignObject x="@F(GroupTitleEditRect(v).X)" y="@F(GroupTitleEditRect(v).Y)" width="@F(GroupTitleEditRect(v).W)" height="24">
                                <input id="edit-box" class="inline-edit group-input" @bind="v.G.Title" @bind:event="oninput" @bind:after="Editor.MarkDirty"
                                       @onblur="Editor.EndEdit" @onkeydown="EditKey" @onpointerdown:stopPropagation="true" />
                            </foreignObject>
                        }
                        else
                        {
                            <g><text class="group-title" x="@F(v.TitleX)" y="@F(v.TitleY)" text-anchor="@v.TitleAnchor" fill="@v.Swatch.Stroke">@v.G.Title</text></g>
                        }
                        @foreach ((double px, double py) in Ports(v.G))
                        {
                            <circle class="port" cx="@F(px)" cy="@F(py)" r="6"
                                    @onpointerdown="e => PortDown(e, v.G.Id)" @onpointerdown:stopPropagation="true" />
                        }
                        @if (v.Selected && Editor.Selection.Count == 1)
                        {
                            <rect class="resize" x="@F(v.G.X + v.G.W - 6)" y="@F(v.G.Y + v.G.H - 6)" width="12" height="12"
                                  @onpointerdown="e => ResizeDown(e, v.G.Id)" @onpointerdown:stopPropagation="true" />
                        }
                    </g>
                }

                @* Text boxes sit underneath connectors and shapes *@
                @foreach (TextBoxView v in TextBoxViews())
                {
                    <g class="textbox @(v.T.IsComment ? "comment" : "") @(v.Selected ? "selected" : "")"
                       @onpointerdown="e => ItemDown(e, v.T.Id)" @onpointerdown:stopPropagation="true"
                       @ondblclick="() => Editor.BeginEdit(v.T.Id)" @ondblclick:stopPropagation="true">
                        @* Always-hittable body; only painted when the box has a fill *@
                        <path d="@v.Outline" fill="@(v.Style.Fill ?? "transparent")" stroke="none" />
                        @if (v.Style.Stroke is null)
                        {
                            <path d="@v.Outline" class="text-guide @(string.IsNullOrWhiteSpace(v.T.Text) ? "empty" : "")" />
                        }
                        else
                        {
                            <path d="@v.Outline" fill="none" stroke="@v.Style.Stroke" stroke-width="@F(v.Style.StrokeWidth)"
                                  stroke-dasharray="@v.Style.Dash" stroke-linecap="@v.Style.Cap" />
                        }
                        @if (v.T.IsComment)
                        {
                            <path d="@SvgShapes.FoldPath(v.T)" fill="none" stroke="@v.Style.FoldColour" />
                        }
                        @if (v.Selected)
                        {
                            <rect x="@F(v.T.X - 4)" y="@F(v.T.Y - 4)" width="@F(v.T.W + 8)" height="@F(v.T.H + 8)" rx="6" class="sel-outline" />
                        }
                        @if (Editor.EditingId == v.T.Id)
                        {
                            <foreignObject x="@F(v.T.X)" y="@F(v.T.Y)" width="@F(v.T.W)" height="@F(Math.Max(v.T.H, v.Layout.ContentHeight))">
                                <textarea id="edit-box" class="inline-edit multiline" style="@TextEditStyle(v.T, v.Style)"
                                          @bind="v.T.Text" @bind:event="oninput" @bind:after="Editor.MarkDirty"
                                          @onblur="Editor.EndEdit" @onpointerdown:stopPropagation="true"></textarea>
                            </foreignObject>
                        }
                        else
                        {
                            <g>
                                <text class="text-body" font-family="@v.Style.Family" font-size="@F(v.T.FontSize)" font-weight="@(v.T.Bold ? "600" : null)"
                                      fill="@v.Style.TextColour" text-anchor="@v.Layout.Anchor">
                                    @foreach (TextLine line in v.Layout.Lines)
                                    {
                                        <tspan x="@F(line.X)" y="@F(line.Y)">@line.Text</tspan>
                                    }
                                </text>
                            </g>
                        }
                        @foreach ((double px, double py) in Ports(v.T))
                        {
                            <circle class="port" cx="@F(px)" cy="@F(py)" r="6"
                                    @onpointerdown="e => PortDown(e, v.T.Id)" @onpointerdown:stopPropagation="true" />
                        }
                        @if (v.Selected && Editor.Selection.Count == 1)
                        {
                            <rect class="resize" x="@F(v.T.X + v.T.W - 6)" y="@F(v.T.Y + v.T.H - 6)" width="12" height="12"
                                  @onpointerdown="e => ResizeDown(e, v.T.Id)" @onpointerdown:stopPropagation="true" />
                        }
                    </g>
                }

                @* Connectors *@
                @foreach (EdgeView v in EdgeViews())
                {
                    <g class="edge @(v.Selected ? "selected" : "")"
                       @onpointerdown="ev => EdgeDown(ev, v.E.Id)" @onpointerdown:stopPropagation="true"
                       @ondblclick="() => Editor.BeginEdit(v.E.Id)" @ondblclick:stopPropagation="true">
                        <path d="@v.Geo.D" class="edge-hit" />
                        @if (v.Selected)
                        {
                            <path d="@v.Geo.D" class="edge-halo" stroke-width="@F(v.Width + 7)" />
                        }
                        <path d="@v.Geo.D" class="edge-line" stroke="@v.Colour" stroke-width="@F(v.Width)"
                              stroke-dasharray="@LineLook.Dash(v.E.Pattern, v.Width)" stroke-linecap="@LineLook.Cap(v.E.Pattern)"
                              marker-end="@(v.E.Arrows == LineLook.ArrowNone ? null : v.Marker)"
                              marker-start="@(v.E.Arrows == LineLook.ArrowBoth ? v.Marker : null)" />
                    </g>
                }

                @* Live connector while dragging from a port *@
                @if (LiveConnector() is { } live)
                {
                    <path d="@live.Path" class="edge-temp" marker-end="url(#arrow-sel)" />
                    @if (live.Target is { } target)
                    {
                        <rect x="@F(target.X - 4)" y="@F(target.Y - 4)" width="@F(target.W + 8)" height="@F(target.H + 8)" rx="8" class="drop-target" />
                    }
                }

                @* Shapes *@
                @foreach (NodeView v in NodeViews())
                {
                    <g class="node @(v.Selected ? "selected" : "")"
                       @onpointerdown="e => ItemDown(e, v.N.Id)" @onpointerdown:stopPropagation="true"
                       @ondblclick="() => Editor.BeginEdit(v.N.Id)" @ondblclick:stopPropagation="true">
                        @if (v.Selected)
                        {
                            <rect x="@F(v.N.X - 5)" y="@F(v.N.Y - 5)" width="@F(v.N.W + 10)" height="@F(v.N.H + 10 + v.Below)" rx="8" class="sel-outline" />
                        }
                        @if (HaloMarkup(v) is { } halo)
                        {
                            <g class="node-halo">@halo</g>
                        }
                        @if (Emphases.Of(v.N).ShadowOpacity > 0)
                        {
                            <path d="@SvgShapes.ShapePath(v.N)" class="node-shadow" transform="@SvgShapes.ShadowTransform" fill="@v.Style.Stroke" fill-opacity="@F(Emphases.Of(v.N).ShadowOpacity)" />
                        }
                        <path d="@SvgShapes.ShapePath(v.N)" fill="@v.Style.Fill" stroke="@v.Style.Stroke" stroke-width="@F(Emphases.Of(v.N).StrokeWidth)" />
                        @if (v.Outline.HasSideStripe)
                        {
                            <rect x="@F(v.N.X)" y="@F(v.N.Y)" width="6" height="@F(v.N.H)" fill="@(v.N.Filled ? "#ffffff" : v.Style.Stroke)" fill-opacity="@(v.N.Filled ? "0.5" : "1")" />
                        }
                        @if (PanelBody(v) is { } body)
                        {
                            <g class="panel-body">@body</g>
                        }
                        @if (v.Layout.HasIcon)
                        {
                            <g class="node-icon" transform="@NodeIconTransform(v.Layout)"
                               fill="none" stroke="@v.Style.IconColor" stroke-width="@F(v.N.Kind.IconStroke)" stroke-linecap="round" stroke-linejoin="round">
                                @NodeIconMarkup(v.N)
                            </g>
                        }
                        @if (v.TextBack is { } back)
                        {
                            <rect class="label-bg" x="@F(back.X)" y="@F(back.Y)" width="@F(back.W)" height="@F(back.H)" rx="4" />
                        }
                        @if (Editor.EditingId == v.N.Id)
                        {
                            <foreignObject x="@F(NodeEditRect(v).X)" y="@F(NodeEditRect(v).Y)" width="@F(NodeEditRect(v).W)" height="@F(NodeEditRect(v).H)">
                                <textarea id="edit-box" class="inline-edit" @bind="v.N.Label" @bind:event="oninput" @bind:after="Editor.MarkDirty"
                                          @onblur="Editor.EndEdit" @onkeydown="EditKey" @onpointerdown:stopPropagation="true"></textarea>
                            </foreignObject>
                        }
                        else
                        {
                            <g>
                                <text class="node-label" x="@F(v.Layout.TextX)" y="@F(v.Layout.TextY)" fill="@(v.Layout.Below ? Emphases.Of(v.N).BelowLabelColour : v.Style.Text)" font-weight="@Emphases.Of(v.N).LabelWeight(v.N)">
                                    @foreach ((string text, string dy) in LabelLines(v.Layout))
                                    {
                                        <tspan x="@F(v.Layout.TextX)" dy="@dy">@text</tspan>
                                    }
                                </text>
                            </g>
                        }
                        @if (v.Layout.Desc.Count > 0)
                        {
                            <g>
                                <text class="node-desc" x="@F(v.Layout.DescX)" y="@F(v.Layout.DescY)">
                                    @foreach ((string text, string dy) in DescLines(v.Layout))
                                    {
                                        <tspan x="@F(v.Layout.DescX)" dy="@dy">@text</tspan>
                                    }
                                </text>
                            </g>
                        }
                        @if (HasProperties(v.N))
                        {
                            <circle cx="@F(v.N.X + v.N.W - 8)" cy="@F(v.N.Y + 8)" r="3.5" fill="@(v.N.Filled ? "#ffffff" : v.Style.Stroke)" class="props-dot">
                                <title>Has properties</title>
                            </circle>
                        }
                        @if (SvgShapes.HasLink(v.N))
                        {
                            <LinkBadge Box="v.N" Colour="@v.Style.Stroke" Link="@(v.N.Link!)" OnFollow="FollowLink" />
                        }
                        @if (SvgShapes.ShownStep(D, v.N) is int step)
                        {
                            <g class="step-badge">@StepBadgeMarkup(v, step)</g>
                        }
                        @foreach ((double px, double py) in Ports(v.N))
                        {
                            <circle class="port" cx="@F(px)" cy="@F(py)" r="6"
                                    @onpointerdown="e => PortDown(e, v.N.Id)" @onpointerdown:stopPropagation="true" />
                        }
                        @foreach ((double px, double py, string itemId) in v.N.Kind.RowPorts(v.N))
                        {
                            <circle class="port row-port" cx="@F(px)" cy="@F(py)" r="5"
                                    @onpointerdown="e => PortDown(e, v.N.Id, itemId)" @onpointerdown:stopPropagation="true" />
                        }
                    </g>
                }

                @* Connectors that end on a row of a list / IPO node: above the shapes, so the end on the row shows *@
                @foreach (EdgeView v in EdgeViews(rowLayer: true))
                {
                    <g class="edge @(v.Selected ? "selected" : "")"
                       @onpointerdown="ev => EdgeDown(ev, v.E.Id)" @onpointerdown:stopPropagation="true"
                       @ondblclick="() => Editor.BeginEdit(v.E.Id)" @ondblclick:stopPropagation="true">
                        <path d="@v.Geo.D" class="edge-hit" />
                        @if (v.Selected)
                        {
                            <path d="@v.Geo.D" class="edge-halo" stroke-width="@F(v.Width + 7)" />
                        }
                        <path d="@v.Geo.D" class="edge-line" stroke="@v.Colour" stroke-width="@F(v.Width)"
                              stroke-dasharray="@LineLook.Dash(v.E.Pattern, v.Width)" stroke-linecap="@LineLook.Cap(v.E.Pattern)"
                              marker-end="@(v.E.Arrows == LineLook.ArrowNone ? null : v.Marker)"
                              marker-start="@(v.E.Arrows == LineLook.ArrowBoth ? v.Marker : null)" />
                    </g>
                }

                @* Group link badges sit above the members so they're never hidden *@
                @foreach (Group g in D.Groups.Where(SvgShapes.HasLink))
                {
                    <LinkBadge Box="g" Colour="@Palette.Get(g.Color).Stroke" Link="@(g.Link!)" OnFollow="FollowLink" />
                }

                @* Connector labels sit above shapes so they're never hidden *@
                @foreach (EdgeLabelView v in EdgeLabelViews())
                {
                    @if (v.Editing)
                    {
                        <foreignObject x="@F(v.Geo.LabelX - 85)" y="@F(v.Geo.LabelY - 22)" width="170" height="44">
                            <textarea id="edit-box" class="inline-edit edge-input two-line" rows="2" @bind="v.E.Label" @bind:event="oninput" @bind:after="Editor.MarkDirty"
                                      @onblur="Editor.EndEdit" @onkeydown="EditKey" @onpointerdown:stopPropagation="true"></textarea>
                        </foreignObject>
                    }
                    else
                    {
                        <g class="edge-label-wrap" transform="@EdgeLabelTransform(v.Geo)"
                           @onpointerdown="ev => EdgeDown(ev, v.E.Id)" @onpointerdown:stopPropagation="true"
                           @ondblclick="() => Editor.BeginEdit(v.E.Id)" @ondblclick:stopPropagation="true">
                            @if (v.Layout.Box is not null)
                            {
                                <rect x="@F(v.Layout.Box.X)" y="@F(v.Layout.Box.Y)" width="@F(v.Layout.Box.W)" height="@F(v.Layout.Box.H)" rx="4" class="edge-label-bg @(v.Selected ? "sel" : "")" />
                            }
                            else
                            {
                                <rect x="@F(v.Layout.Hit.X)" y="@F(v.Layout.Hit.Y)" width="@F(v.Layout.Hit.W)" height="@F(v.Layout.Hit.H)" rx="3" class="edge-label-hit @(v.Selected ? "sel" : "")" />
                            }
                            <text class="edge-label @(v.Layout.Halo ? "halo" : "")" text-anchor="@v.Layout.Anchor">
                                @foreach (EdgeLabelLine line in v.Layout.Lines)
                                {
                                    <tspan x="@F(line.X)" y="@F(line.Y)">@line.Text</tspan>
                                }
                            </text>
                        </g>
                    }
                }

                @* Handles on the selected connector: ends (move to another side) and the bend (drag sideways) *@
                @if (SelectedEdgeHandles() is { } h)
                {
                    @foreach (SideTarget s in h.Sides)
                    {
                        <circle class="side-target @(s.Current ? "on" : "")" cx="@F(s.X)" cy="@F(s.Y)" r="@F(7 / Zoom)" />
                    }
                    @if (h.HasBend)
                    {
                        <rect class="bend-handle @(h.BendVertical ? "ew" : "ns")" x="@F(h.BendX - BendHandleSize / 2)" y="@F(h.BendY - BendHandleSize / 2)"
                              width="@F(BendHandleSize)" height="@F(BendHandleSize)" rx="@F(2 / Zoom)"
                              @onpointerdown="ev => BendDown(ev, h.EdgeId)" @onpointerdown:stopPropagation="true"
                              @ondblclick="() => Editor.ResetBend(h.EdgeId)" @ondblclick:stopPropagation="true">
                            <title>Drag to move this segment · double-click to reset</title>
                        </rect>
                    }
                    <circle class="edge-handle" cx="@F(h.StartX)" cy="@F(h.StartY)" r="@F(6 / Zoom)"
                            @onpointerdown="ev => EdgeEndDown(ev, h.EdgeId, true)" @onpointerdown:stopPropagation="true">
                        <title>Drag to another side of the shape</title>
                    </circle>
                    <circle class="edge-handle" cx="@F(h.EndX)" cy="@F(h.EndY)" r="@F(6 / Zoom)"
                            @onpointerdown="ev => EdgeEndDown(ev, h.EdgeId, false)" @onpointerdown:stopPropagation="true">
                        <title>Drag to another side of the shape</title>
                    </circle>
                }

                @if (Marquee is { } mq)
                {
                    <rect class="marquee" x="@F(mq.X)" y="@F(mq.Y)" width="@F(mq.W)" height="@F(mq.H)" />
                }
            </g>
        </svg>

        @if (Editor.IsBlank)
        {
            <div class="empty-hint">
                <div class="big">Drag a shape here to start</div>
                <div>Or click a shape in the sidebar · double-click the canvas to add a process step</div>
                <LaneCreator Editor="Editor" OnCreated="FitAfterLanes" />
            </div>
        }
    </main>

    @* ───────────── Properties panel ───────────── *@
    <aside class="panel">
        @if (Editor.SelectedNode is { } sn)
        {
            <ShapePanel Host="this" Node="sn" @bind-IconFilter="iconFilter" />
        }
        else if (Editor.SelectedText is { } st)
        {
            <TextBoxPanel Host="this" Box="st" />
        }
        else if (Editor.SelectedEdge is { } se)
        {
            <ConnectorPanel Host="this" Edge="se" />
        }
        else if (Editor.SelectedGroup is { } sg)
        {
            <GroupPanel Host="this" Group="sg" />
        }
        else if (Editor.Selection.Count > 1)
        {
            <SelectionPanel Host="this" />
        }
        else
        {
            <DiagramPanel Host="this" />
        }
    </aside>

    <footer class="status">
        <span>Saved to: @Store.Folder</span>
        <span>@D.Page.Describe()</span>
        @if (D.Page.Enabled && OffPageCount > 0)
        {
            <span class="status-warn">⚠ @OffPageCount item@(OffPageCount == 1 ? "" : "s") off the page</span>
        }
        @if (!string.IsNullOrEmpty(toast))
        {
            <span class="toast">@toast</span>
        }
    </footer>
</div>

@* ───────────── Dialogs ───────────── *@
@if (dialog == Dialog.Open)
{
    <div class="modal-bg" @onclick="CloseDialog">
        <div class="modal" @onclick:stopPropagation="true">
            <h3>Open diagram</h3>
            @if (Editor.Dirty) { <p class="warn">You have unsaved changes — opening another diagram will discard them.</p> }
            @if (openFiles.Count == 0)
            {
                <p class="muted">No saved diagrams yet in @Store.Folder</p>
            }
            <ul class="files">
                @foreach ((string name, DateTime modified) in openFiles)
                {
                    <li>
                        <button class="link" @onclick="() => Open(name)">@name</button>
                        <span class="muted">@modified.ToString("dd MMM yyyy HH:mm")</span>
                        @if (confirmDelete == name)
                        {
                            <button class="danger small" @onclick="() => DeleteFile(name)">Confirm delete</button>
                        }
                        else
                        {
                            <button class="icon" title="Delete file" @onclick="() => AskDelete(name)">🗑</button>
                        }
                    </li>
                }
            </ul>
            <div class="actions"><button @onclick="CloseDialog">Cancel</button></div>
        </div>
    </div>
}
else if (dialog == Dialog.SaveAs)
{
    <div class="modal-bg" @onclick="CloseDialog">
        <div class="modal" @onclick:stopPropagation="true">
            <h3>Save diagram as</h3>
            <label>Name</label>
            <input id="saveas-name" @bind="saveAsName" @bind:event="oninput" @onkeydown="SaveAsKey" />
            @if (SaveAsWillOverwrite)
            {
                <p class="warn">A diagram with this name exists and will be overwritten.</p>
            }
            <p class="muted">@SaveAsPath</p>
            <div class="actions">
                <button @onclick="CloseDialog">Cancel</button>
                <button class="primary" @onclick="ConfirmSaveAs">Save</button>
            </div>
        </div>
    </div>
}
else if (dialog == Dialog.ConfirmLeave && pendingNav is { } nav)
{
    <div class="modal-bg" @onclick="CancelLeave">
        <div class="modal" @onclick:stopPropagation="true">
            <h3>Save changes before leaving?</h3>
            <p>"@D.Name" has changes that haven't been saved. You're about to open "@nav.Target".</p>
            @if (!hasFile)
            {
                <p class="muted">This diagram has never been saved, so you won't be able to come back to it with Back. Cancel and use Save as… first to keep it.</p>
            }
            <div class="actions">
                <button @onclick="CancelLeave">Cancel</button>
                <button class="danger" @onclick="() => ConfirmLeave(false)">Discard and open</button>
                @if (hasFile)
                {
                    <button class="primary" @onclick="() => ConfirmLeave(true)">Save and open</button>
                }
            </div>
        </div>
    </div>
}
else if (dialog == Dialog.Shortcuts)
{
    <ShortcutsDialog Commands="Commands" OnClose="CloseDialog" />
}
else if (dialog == Dialog.StepOrder)
{
    <StepOrderDialog Editor="Editor" OnChanged="StateHasChanged" OnClose="CloseDialog" />
}
else if (dialog == Dialog.ConfirmNew)
{
    <div class="modal-bg" @onclick="CloseDialog">
        <div class="modal" @onclick:stopPropagation="true">
            <h3>Discard unsaved changes?</h3>
            <p>"@D.Name" has changes that haven't been saved.</p>
            <div class="actions">
                <button @onclick="CloseDialog">Cancel</button>
                <button class="danger" @onclick="DiscardAndNew">Discard and start new</button>
            </div>
        </div>
    </div>
}
