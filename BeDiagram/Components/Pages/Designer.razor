@page "/"
@implements IAsyncDisposable

<PageTitle>@(D.Name)@(Editor.Dirty ? " •" : "") — BeDiagram</PageTitle>

<div class="app">
    @* ───────────── Toolbar and palette (Components/Bars) ───────────── *@
    <Toolbar Host="this" />
    <ShapePalette Host="this" />

    @* ───────────── Canvas ───────────── *@
    <main class="canvas" @ref="canvasEl"
          @ondragover:preventDefault="true" @ondragover="DragOver"
          @ondrop="OnDrop">
        <svg class="@SurfaceClass"
             @onpointerdown="BgDown" @onpointermove="PointerMove"
             @onpointerup="PointerUp" @onpointerleave="PointerUp"
             @ondblclick="BgDoubleClick">
            <defs>
                <pattern id="grid" width="20" height="20" patternUnits="userSpaceOnUse" patternTransform="@GridTransform">
                    <circle cx="1" cy="1" r="1" fill="#cfd5dc" />
                </pattern>
                <pattern id="grid-world" width="20" height="20" patternUnits="userSpaceOnUse">
                    <circle cx="1" cy="1" r="1" fill="#d5dae0" />
                </pattern>
                <pattern id="grid-lines" width="20" height="20" patternUnits="userSpaceOnUse" patternTransform="@GridTransform">
                    <path d="M20 0.5 H0.5 V20" fill="none" stroke="#dde2e8" stroke-width="1" />
                </pattern>
                <pattern id="grid-world-lines" width="20" height="20" patternUnits="userSpaceOnUse">
                    <path d="M20 0.5 H0.5 V20" fill="none" stroke="#e4e8ed" stroke-width="1" />
                </pattern>
                <filter id="page-shadow" x="-5%" y="-5%" width="110%" height="110%">
                    <feDropShadow dx="0" dy="2" stdDeviation="6" flood-color="#1f2933" flood-opacity="0.16" />
                </filter>
                <marker id="arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="8" markerHeight="8" orient="auto-start-reverse">
                    <path d="M0,0 L10,5 L0,10 z" fill="#55606e" />
                </marker>
                <marker id="arrow-sel" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="8" markerHeight="8" orient="auto-start-reverse">
                    <path d="M0,0 L10,5 L0,10 z" fill="#2563eb" />
                </marker>
                @ArrowMarkerDefs
            </defs>
            <rect class="grid" width="100%" height="100%" fill="@CanvasFill" />

            <g transform="@GridTransform">
                @* Page sheet (fixed paper size) *@
                <PageSheet Host="this" />

                @* Page title and description (fixed page only) *@
                <PageHeaderLayer Host="this" />

                @* Groups are the bottom layer *@
                <GroupLayer Host="this" />

                @* Text boxes sit underneath connectors and shapes *@
                <TextBoxLayer Host="this" />

                @* Connectors *@
                <EdgeLayer Host="this" />

                @* Live connector while dragging from a port *@
                @if (LiveConnector() is { } live)
                {
                    <path d="@live.Path" class="edge-temp" marker-end="url(#arrow-sel)" />
                    @if (live.Target is { } target)
                    {
                        <rect x="@F(target.X - 4)" y="@F(target.Y - 4)" width="@F(target.W + 8)" height="@F(target.H + 8)" rx="8" class="drop-target" />
                    }
                }

                @* Shapes *@
                <NodeLayer Host="this" />

                @* Connectors that end on a row of a list / IPO node: above the shapes, so the end on the row shows *@
                <EdgeLayer Host="this" RowLayer="true" />

                @* Group link badges sit above the members so they're never hidden *@
                @foreach (Group g in D.Groups.Where(SvgShapes.HasLink))
                {
                    <LinkBadge Box="g" Colour="@Palette.Get(g.Color).Stroke" Link="@(g.Link!)" OnFollow="FollowLink" />
                }

                @* Connector labels sit above shapes so they're never hidden *@
                <EdgeLabelLayer Host="this" />

                @* Handles on the selected connector: ends (move to another side) and the bend (drag sideways) *@
                @if (SelectedEdgeHandles() is { } h)
                {
                    @foreach (SideTarget s in h.Sides)
                    {
                        <circle class="side-target @(s.Current ? "on" : "")" cx="@F(s.X)" cy="@F(s.Y)" r="@F(7 / Zoom)" />
                    }
                    @if (h.HasBend)
                    {
                        <rect class="bend-handle @(h.BendVertical ? "ew" : "ns")" x="@F(h.BendX - BendHandleSize / 2)" y="@F(h.BendY - BendHandleSize / 2)"
                              width="@F(BendHandleSize)" height="@F(BendHandleSize)" rx="@F(2 / Zoom)"
                              @onpointerdown="ev => BendDown(ev, h.EdgeId)" @onpointerdown:stopPropagation="true"
                              @ondblclick="() => Editor.ResetBend(h.EdgeId)" @ondblclick:stopPropagation="true">
                            <title>Drag to move this segment · double-click to reset</title>
                        </rect>
                    }
                    <circle class="edge-handle" cx="@F(h.StartX)" cy="@F(h.StartY)" r="@F(6 / Zoom)"
                            @onpointerdown="ev => EdgeEndDown(ev, h.EdgeId, true)" @onpointerdown:stopPropagation="true">
                        <title>Drag to another side of the shape</title>
                    </circle>
                    <circle class="edge-handle" cx="@F(h.EndX)" cy="@F(h.EndY)" r="@F(6 / Zoom)"
                            @onpointerdown="ev => EdgeEndDown(ev, h.EdgeId, false)" @onpointerdown:stopPropagation="true">
                        <title>Drag to another side of the shape</title>
                    </circle>
                }

                @if (Marquee is { } mq)
                {
                    <rect class="marquee" x="@F(mq.X)" y="@F(mq.Y)" width="@F(mq.W)" height="@F(mq.H)" />
                }
            </g>
        </svg>

        @if (Editor.IsBlank)
        {
            <div class="empty-hint">
                <div class="big">Drag a shape here to start</div>
                <div>Or click a shape in the sidebar · double-click the canvas to add a process step</div>
                <LaneCreator Editor="Editor" OnCreated="FitAfterLanes" />
            </div>
        }
    </main>

    @* ───────────── Side panel for the selection (Components/Panels) ───────────── *@
    <aside class="panel">
        @if (Editor.SelectedNode is { } sn)
        {
            <ShapePanel Host="this" Node="sn" @bind-IconFilter="iconFilter" />
        }
        else if (Editor.SelectedText is { } st)
        {
            <TextBoxPanel Host="this" Box="st" />
        }
        else if (Editor.SelectedEdge is { } se)
        {
            <ConnectorPanel Host="this" Edge="se" />
        }
        else if (Editor.SelectedGroup is { } sg)
        {
            <GroupPanel Host="this" Group="sg" />
        }
        else if (Editor.Selection.Count > 1)
        {
            <SelectionPanel Host="this" />
        }
        else
        {
            <DiagramPanel Host="this" />
        }
    </aside>

    <StatusBar Host="this" />
</div>

@* ───────────── Dialogs (Components/Dialogs) ───────────── *@
@if (dialog == Dialog.Open)
{
    <OpenDialog Dirty="@Editor.Dirty" StartFolder="@OpenFolder" OnOpen="Open" OnDelete="DeleteFile" OnClose="CloseDialog" />
}
else if (dialog == Dialog.SaveAs)
{
    <SaveAsDialog Name="@D.Name" SavedName="@SavedName" OnSave="ConfirmSaveAs" OnCancel="CloseDialog" />
}
else if (dialog == Dialog.ConfirmLeave && pendingNav is { } nav)
{
    <ConfirmLeaveDialog DiagramName="@D.Name" Target="@nav.Target" HasFile="@hasFile" OnConfirm="ConfirmLeave" OnCancel="CancelLeave" />
}
else if (dialog == Dialog.Shortcuts)
{
    <ShortcutsDialog Commands="Commands" OnClose="CloseDialog" />
}
else if (dialog == Dialog.StepOrder)
{
    <StepOrderDialog Editor="Editor" OnChanged="StateHasChanged" OnClose="CloseDialog" />
}
else if (dialog == Dialog.ConfirmNew)
{
    <ConfirmNewDialog DiagramName="@D.Name" OnDiscard="DiscardAndNew" OnCancel="CloseDialog" />
}
