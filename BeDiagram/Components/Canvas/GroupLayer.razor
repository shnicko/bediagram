@inherits CanvasLayer
@using BeDiagram.Components.Pages.Gestures
@using BeDiagram.Editing.Lanes

@foreach (GroupView v in GroupViews())
{
    <g class="group @(v.Selected ? "selected" : "")">
        @if (v.Selected)
        {
            <rect class="sel-outline" x="@F(GroupSelectionRect(v.G).X)" y="@F(GroupSelectionRect(v.G).Y)"
                  width="@F(GroupSelectionRect(v.G).W)" height="@F(GroupSelectionRect(v.G).H)" rx="13" />
        }
        <rect class="group-body" x="@F(v.G.X)" y="@F(v.G.Y)" width="@F(v.G.W)" height="@F(v.G.H)" rx="10"
              fill="@v.Swatch.Light" fill-opacity="@F(v.FillOpacity)" stroke="@v.Swatch.Stroke" stroke-width="@F(v.Width)"
              stroke-dasharray="@v.Dash"
              @onpointerdown="e => Input.GroupBodyDown(e, v.G.Id)" @onpointerdown:stopPropagation="true" />
        @if (v.BandPath is { } band)
        {
            <path d="@band" fill="@v.Swatch.Stroke" fill-opacity="0.14" pointer-events="none" />
        }
        @* Title area: the drag handle (double-click to rename) *@
        <rect class="group-header" x="@F(v.TitleArea.X)" y="@F(v.TitleArea.Y)" width="@F(v.TitleArea.W)" height="@F(v.TitleArea.H)" fill="transparent"
              @onpointerdown="e => Input.ItemDown(e, v.G.Id)" @onpointerdown:stopPropagation="true"
              @ondblclick="() => Editor.BeginEdit(v.G.Id)" @ondblclick:stopPropagation="true" />
        @if (Editor.EditingId == v.G.Id)
        {
            <foreignObject x="@F(GroupTitleEditRect(v).X)" y="@F(GroupTitleEditRect(v).Y)" width="@F(GroupTitleEditRect(v).W)" height="24">
                <input id="edit-box" class="inline-edit group-input" @bind="v.G.Title" @bind:event="oninput" @bind:after="Editor.MarkDirty"
                       @onblur="Editor.EndEdit" @onkeydown="EditKey" @onpointerdown:stopPropagation="true" />
            </foreignObject>
        }
        else
        {
            <g><text class="group-title" x="@F(v.TitleX)" y="@F(v.TitleY)" text-anchor="@v.TitleAnchor" fill="@v.Swatch.Stroke">@v.G.Title</text></g>
        }
        @if (ShowsGrips(v))
        {
            @* Each side can be dragged anywhere along it (an invisible strip, short of the corners); the ● port in the
               middle is drawn over it so connecting still works *@
            @foreach (ResizeHandle h in ResizeHandle.Sides())
            {
                <rect class="grip-edge @h.CursorClass()" x="@F(EdgeStripRect(v.G, h).X)" y="@F(EdgeStripRect(v.G, h).Y)"
                      width="@F(EdgeStripRect(v.G, h).W)" height="@F(EdgeStripRect(v.G, h).H)"
                      @onpointerdown="e => Input.ResizeDown(e, v.G.Id, h)" @onpointerdown:stopPropagation="true" />
            }
        }
        @foreach ((double px, double py) in Ports(v.G))
        {
            <circle class="port" cx="@F(px)" cy="@F(py)" r="6"
                    @onpointerdown="e => Input.PortDown(e, v.G.Id)" @onpointerdown:stopPropagation="true" />
        }
        @if (ShowsGrips(v))
        {
            @foreach (ResizeHandle h in ResizeHandle.Corners())
            {
                <rect class="resize @h.CursorClass()" x="@F(GripRect(v.G, h).X)" y="@F(GripRect(v.G, h).Y)" width="12" height="12"
                      @onpointerdown="e => Input.ResizeDown(e, v.G.Id, h)" @onpointerdown:stopPropagation="true" />
            }
        }
    </g>
}
@* Edges shared by touching lanes, over every group: drag one to resize both lanes. Gaps are left around the ● ports
   and the corners, so connecting and the corner grips still work there. *@
@foreach ((LaneDivider d, Rect r) in DividerStrips())
{
    <rect class="lane-divider @(d.Rows ? "rows" : "cols")" x="@F(r.X)" y="@F(r.Y)" width="@F(r.W)" height="@F(r.H)"
          @onpointerdown="e => Input.DividerDown(e, d)" @onpointerdown:stopPropagation="true" />
}
