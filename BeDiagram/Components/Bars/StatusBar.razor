@inherits DesignerPart

<footer class="status">
    <span>Saved to: @Store.Folder</span>
    <span>@D.Page.Describe()</span>
    @if (D.Page.Enabled && OffPageCount > 0)
    {
        <span class="status-warn">⚠ @OffPageCount item@(OffPageCount == 1 ? "" : "s") off the page</span>
    }
    @if (Editor.ShapesLocked)
    {
        <span class="status-lock">@IconSvg("lock", 14) Shapes locked in place <button class="link" @onclick="Unlock">Unlock</button></span>
    }
    @if (Clipboard.Held is CopiedStyle held)
    {
        <span class="style-chip" title="The copied style: Ctrl+Alt+V pastes it onto the selection (in any tab), P paints it on with the format painter">@IconSvg("paintbrush", 13) @held.Summary <button class="link" title="Forget the copied style" @onclick="ClearStyle">×</button></span>
    }
    @if (!string.IsNullOrEmpty(Host.Toast))
    {
        <span class="toast">@Host.Toast</span>
    }
</footer>
